# Local preview uses ignored public/media files when this is unset.
# After uploading media/ to a bucket with a public HTTPS custom domain:
# NEXT_PUBLIC_MEDIA_BASE_URL=https://media.your-domain.example

# Upload to Cloudflare R2 (npm run media:upload). Put real values only in .env.local,
# which Git ignores. Token: R2 "Object Read & Write" scoped to this one bucket.
# R2_ACCOUNT_ID=
# R2_BUCKET=kymsul-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
